cv-service/sym_shape_infer_temp.onnx
cv-service/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*-*-*-*

__pycache__/
*.pyc
.venv*/
